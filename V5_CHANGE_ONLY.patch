+                "Total cycles consumed: 100", encoding="utf-8"
+            )
+            with self.assertRaises(ValueError):
+                parse_trace_logs.parse_trace_directory(
+                    root, trace="gemm_heavy", n=3, max_span=2, strict=True
+                )
+
